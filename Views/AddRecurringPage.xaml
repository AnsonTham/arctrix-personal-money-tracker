<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:views="clr-namespace:Arctrix.PersonalMoneyTracker.Views"
             xmlns:controls="clr-namespace:Arctrix.PersonalMoneyTracker.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Arctrix.PersonalMoneyTracker.ViewModels"
             xmlns:models="clr-namespace:Arctrix.PersonalMoneyTracker.Models"
             x:Class="Arctrix.PersonalMoneyTracker.Views.AddRecurringPage"
             x:DataType="vm:AddRecurringViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <Grid x:Name="LayoutRoot" HorizontalOptions="Center" Padding="32,28,32,40" RowDefinitions="Auto,Auto" RowSpacing="20">

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutStates">
                    <VisualState x:Name="Wide" />
                    <VisualState x:Name="Narrow">
                        <VisualState.Setters>
                            <Setter Property="Padding" Value="{StaticResource PagePaddingPhone}" />
                            <Setter Property="RowSpacing" Value="16" />
                            <Setter TargetName="Header" Property="Margin" Value="0,8,0,0" />
                            <Setter TargetName="FormCard" Property="Padding" Value="18" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="Header" ColumnDefinitions="Auto,*">
                <controls:BackButton />
                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource H1}" VerticalOptions="Center" />
            </Grid>

            <Border x:Name="FormCard" Grid.Row="1" Style="{StaticResource Card}" Padding="28" VerticalOptions="Start">
                <VerticalStackLayout Spacing="24">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Name" Style="{StaticResource Overline}" />
                        <Border Style="{StaticResource InputShell}">
                            <Entry Text="{Binding Name}" Placeholder="e.g. Rent, Netflix, Salary" MaxLength="80" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Type" Style="{StaticResource Overline}" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding TypeOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterOption">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}">
                                                <TapGestureRecognizer.Command>
                                                    <Binding Path="SelectTypeCommand"
                                                             Source="{RelativeSource AncestorType={x:Type vm:AddRecurringViewModel}}"
                                                             x:DataType="vm:AddRecurringViewModel" />
                                                </TapGestureRecognizer.Command>
                                            </TapGestureRecognizer>
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Name}" FontFamily="InterMedium" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,150" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Amount" Style="{StaticResource Overline}" />
                            <Border Style="{StaticResource InputShell}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="{Binding BaseCurrency}" FontFamily="InterSemiBold" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding AmountText}" Placeholder="0.00" Keyboard="Numeric" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <Label Text="Day of month" Style="{StaticResource Overline}" />
                            <Border Style="{StaticResource InputShell}">
                                <Picker ItemsSource="{Binding DaysOfMonth}" SelectedItem="{Binding DayOfMonth}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Account" Style="{StaticResource Overline}" />
                        <Border Style="{StaticResource InputShell}">
                            <Picker Title="{OnPlatform Default='Choose account', WinUI={x:Null}}"
                                    ItemsSource="{Binding Accounts}"
                                    SelectedItem="{Binding SelectedAccount}">
                                <Picker.ItemDisplayBinding>
                                    <Binding Path="Name" x:DataType="models:Account" />
                                </Picker.ItemDisplayBinding>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Category" Style="{StaticResource Overline}" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding CategoryOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryOption">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,8" Padding="12,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}">
                                                <TapGestureRecognizer.Command>
                                                    <Binding Path="SelectCategoryCommand"
                                                             Source="{RelativeSource AncestorType={x:Type vm:AddRecurringViewModel}}"
                                                             x:DataType="vm:AddRecurringViewModel" />
                                                </TapGestureRecognizer.Command>
                                            </TapGestureRecognizer>
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Image Source="{Binding Category.IconFile}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                            <Label Text="{Binding Category.Name}" FontFamily="InterMedium" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <Label Text="{Binding FirstPaymentLabel}" Style="{StaticResource Body}" />

                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}" />

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <Button Grid.Column="1" Text="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" />
                        <Button Grid.Column="2" Text="Add recurring payment" Command="{Binding SaveCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>

</views:AppPage>
