<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:views="clr-namespace:Arctrix.PersonalMoneyTracker.Views"
             xmlns:controls="clr-namespace:Arctrix.PersonalMoneyTracker.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Arctrix.PersonalMoneyTracker.ViewModels"
             x:Class="Arctrix.PersonalMoneyTracker.Views.RecurringPage"
             x:DataType="vm:RecurringViewModel"
             Title="{Binding Title}">

    <Grid x:Name="LayoutRoot"
          HorizontalOptions="Center"
          Padding="{StaticResource PagePaddingDesktop}"
          ColumnDefinitions="*,320"
          RowDefinitions="Auto,*"
          ColumnSpacing="24"
          RowSpacing="20">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Property="Padding" Value="{StaticResource PagePaddingPhone}" />
                        <Setter Property="ColumnDefinitions" Value="*" />
                        <Setter Property="RowDefinitions" Value="Auto,Auto,*" />
                        <Setter Property="ColumnSpacing" Value="0" />
                        <Setter Property="RowSpacing" Value="12" />

                        <Setter TargetName="Header" Property="Margin" Value="4,16,4,0" />
                        <Setter TargetName="SummaryColumn" Property="Grid.Row" Value="1" />
                        <Setter TargetName="SummaryColumn" Property="Grid.Column" Value="0" />
                        <Setter TargetName="ListCard" Property="Grid.Row" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Header -->
        <Grid x:Name="Header" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto">
            <controls:BackButton />
            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label Text="{Binding Title}" Style="{StaticResource H1}" />
                <Label Text="{Binding CountLabel}" Style="{StaticResource Body}" />
            </VerticalStackLayout>
            <Button Grid.Column="2"
                    Text="Add recurring"
                    VerticalOptions="Center"
                    Command="{Binding AddRecurringCommand}" />
        </Grid>

        <!-- Payments -->
        <Border x:Name="ListCard" Grid.Row="1" Style="{StaticResource Card}" Padding="8,4">
            <CollectionView ItemsSource="{Binding Payments}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecurringRowViewModel">
                        <Border Background="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>

                            <!-- Name and amount on top; the schedule gets the full text width so it never
                                 truncates; due date and Stop share the last row, away from the amount. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="2">
                                <Border Grid.RowSpan="2" Style="{StaticResource IconTile}" VerticalOptions="Start">
                                    <Image Source="{Binding CategoryIconFile}" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyStrong}" MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" />

                                <Label Grid.Column="2" Text="{Binding AmountLabel}" Style="{StaticResource Amount}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Positive}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ScheduleLabel}" Style="{StaticResource Caption}" />

                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding DueLabel}" Style="{StaticResource Caption}" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Negative}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Button Grid.Row="2"
                                        Grid.Column="2"
                                        Text="Stop"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="13"
                                        MinimumWidthRequest="48"
                                        Padding="14,0"
                                        Margin="0,6,0,0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        SemanticProperties.Description="{Binding Name, StringFormat='Stop {0}'}"
                                        CommandParameter="{Binding .}">
                                    <Button.Command>
                                        <Binding Path="StopCommand"
                                                 Source="{RelativeSource AncestorType={x:Type vm:RecurringViewModel}}"
                                                 x:DataType="vm:RecurringViewModel" />
                                    </Button.Command>
                                </Button>

                                <!-- Only present while an occurrence is waiting on funds; it says what is
                                     missing rather than quietly letting the account go negative. -->
                                <Label Grid.Row="3"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding SkipLabel}"
                                       IsVisible="{Binding HasSkip}"
                                       Style="{StaticResource Caption}"
                                       TextColor="{StaticResource Negative}"
                                       Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="16,48" Spacing="12" HorizontalOptions="Center">
                        <Label Text="No recurring payments" Style="{StaticResource H3}" HorizontalTextAlignment="Center" />
                        <Label Text="Add subscriptions, rent or salary and they'll post automatically on their due date."
                               Style="{StaticResource Body}"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Add recurring" HorizontalOptions="Center" Command="{Binding AddRecurringCommand}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>

        <!-- Summary, and the prepaid pools that cover some of these payments -->
        <VerticalStackLayout x:Name="SummaryColumn" Grid.Row="1" Grid.Column="1" Spacing="20" VerticalOptions="Start">
        <Border x:Name="SummaryCard"
                Style="{StaticResource Card}"
                VerticalOptions="Start">
            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Monthly commitments" Style="{StaticResource Overline}" />
                    <Label Style="{StaticResource AmountLarge}" FontSize="30">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding BaseCurrency}" FontSize="15" FontFamily="InterSemiBold" TextColor="{StaticResource Muted}" />
                                <Span Text=" " />
                                <Span Text="{Binding MonthlyOutflow, StringFormat='{0:N2}'}" FontFamily="InterBold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Recurring spending each month" Style="{StaticResource Caption}" />
                </VerticalStackLayout>

                <BoxView Style="{StaticResource Divider}" />

                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{StaticResource Positive}" VerticalOptions="Center" />
                        <Label Text="Recurring income" Style="{StaticResource Body}" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1" Text="{Binding MonthlyInflow, StringFormat='{0:N2}'}" Style="{StaticResource Amount}" />
                </Grid>

                <BoxView Style="{StaticResource Divider}" />

                <VerticalStackLayout Spacing="6">
                    <Label Text="Next up" Style="{StaticResource Overline}" />
                    <Label Text="{Binding NextUpLabel}" Style="{StaticResource BodyStrong}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Prepaid credit: money collected upfront, counted down month by month. Nothing here
             posts a transaction - the lump sum is ordinary income and the subscription it covers
             keeps posting as it always did. -->
        <Border x:Name="PrepaidCard" Style="{StaticResource Card}" VerticalOptions="Start">
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Prepaid credit" Style="{StaticResource Overline}" VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Add"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="13"
                            Padding="14,0"
                            MinimumWidthRequest="48"
                            VerticalOptions="Center"
                            Command="{Binding AddPrepaidCreditCommand}" />
                </Grid>

                <Label Text="Nothing prepaid right now. Add a lump sum you've collected that covers several months."
                       Style="{StaticResource Caption}"
                       IsVisible="{Binding ShowPrepaidEmptyState}" />

                <VerticalStackLayout Spacing="18" BindableLayout.ItemsSource="{Binding PrepaidCredits}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PrepaidCreditRowViewModel">
                            <VerticalStackLayout Spacing="6">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}">
                                        <TapGestureRecognizer.Command>
                                            <Binding Path="EditPrepaidCreditCommand"
                                                     Source="{RelativeSource AncestorType={x:Type vm:RecurringViewModel}}"
                                                     x:DataType="vm:RecurringViewModel" />
                                        </TapGestureRecognizer.Command>
                                    </TapGestureRecognizer>
                                </VerticalStackLayout.GestureRecognizers>

                                <Label Text="{Binding Name}" Style="{StaticResource BodyStrong}" MaxLines="2" LineBreakMode="TailTruncation" />

                                <Label Text="{Binding LinkedLabel}"
                                       Style="{StaticResource Caption}"
                                       IsVisible="{Binding HasLinkedPayment}" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding UsageLabel}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding RemainingLabel}" Style="{StaticResource Amount}" FontSize="14" VerticalOptions="Center" />
                                </Grid>

                                <controls:ProportionBar Value="{Binding UsedShare}"
                                                        BarColor="{StaticResource Accent}"
                                                        TrackColor="{StaticResource Surface3}" />

                                <Label Text="{Binding NoticeLabel}" Style="{StaticResource Caption}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsNoticeUrgent}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Negative}" />
                                            <Setter Property="FontFamily" Value="InterSemiBold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
        </VerticalStackLayout>

    </Grid>

</views:AppPage>
