<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Arctrix.PersonalMoneyTracker.Views"
             xmlns:controls="clr-namespace:Arctrix.PersonalMoneyTracker.Controls"
             xmlns:vm="clr-namespace:Arctrix.PersonalMoneyTracker.ViewModels"
             x:Class="Arctrix.PersonalMoneyTracker.Views.ReceiptPhotoPage"
             x:DataType="vm:ReceiptPhotoViewModel"
             Title="{Binding Title}">

    <Grid Padding="{StaticResource PagePaddingPhone}" RowDefinitions="Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="Auto,*" Margin="0,8,0,0">
            <controls:BackButton />
            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource H1}" VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <Image Source="{Binding PhotoPath}" Aspect="AspectFit" SemanticProperties.Description="Photo of the receipt" />
        </Border>
    </Grid>

</views:AppPage>
