<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:views="clr-namespace:Arctrix.PersonalMoneyTracker.Views"
             xmlns:controls="clr-namespace:Arctrix.PersonalMoneyTracker.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Arctrix.PersonalMoneyTracker.ViewModels"
             xmlns:models="clr-namespace:Arctrix.PersonalMoneyTracker.Models"
             x:Class="Arctrix.PersonalMoneyTracker.Views.AddEditTransactionPage"
             x:DataType="vm:AddEditTransactionViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <Grid x:Name="LayoutRoot" HorizontalOptions="Center" Padding="32,28,32,40" RowDefinitions="Auto,Auto" RowSpacing="20">

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutStates">
                    <VisualState x:Name="Wide" />
                    <VisualState x:Name="Narrow">
                        <VisualState.Setters>
                            <Setter Property="Padding" Value="{StaticResource PagePaddingPhone}" />
                            <Setter Property="RowSpacing" Value="16" />
                            <Setter TargetName="Header" Property="Margin" Value="0,8,0,0" />
                            <Setter TargetName="FormCard" Property="Padding" Value="18" />
                            <Setter TargetName="FieldsGrid" Property="Grid.ColumnDefinitions" Value="*" />
                            <Setter TargetName="FieldsGrid" Property="Grid.RowDefinitions" Value="Auto,Auto,Auto,Auto" />
                            <Setter TargetName="ToField" Property="Grid.Row" Value="1" />
                            <Setter TargetName="ToField" Property="Grid.Column" Value="0" />
                            <Setter TargetName="DateField" Property="Grid.Row" Value="2" />
                            <Setter TargetName="NotesField" Property="Grid.Row" Value="3" />
                            <Setter TargetName="NotesField" Property="Grid.Column" Value="0" />
                            <!-- Stacked fields space themselves with margins: row spacing would leave a
                                 double gap where the hidden "To account" row sits. -->
                            <Setter TargetName="FieldsGrid" Property="Grid.RowSpacing" Value="0" />
                            <Setter TargetName="FromField" Property="Margin" Value="0,0,0,22" />
                            <Setter TargetName="ToField" Property="Margin" Value="0,0,0,22" />
                            <Setter TargetName="DateField" Property="Margin" Value="0,0,0,22" />

                            <!-- Three buttons don't fit one narrow row: save gets its own. -->
                            <Setter TargetName="ActionsGrid" Property="Grid.ColumnDefinitions" Value="*,*" />
                            <Setter TargetName="ActionsGrid" Property="Grid.RowDefinitions" Value="Auto,Auto" />
                            <Setter TargetName="SaveButton" Property="Grid.Row" Value="0" />
                            <Setter TargetName="SaveButton" Property="Grid.Column" Value="0" />
                            <Setter TargetName="SaveButton" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="DeleteButton" Property="Grid.Row" Value="1" />
                            <Setter TargetName="CancelButton" Property="Grid.Row" Value="1" />
                            <Setter TargetName="CancelButton" Property="Grid.Column" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="Header" ColumnDefinitions="Auto,*">
                <controls:BackButton />
                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource H1}" VerticalOptions="Center" />
            </Grid>

            <Border x:Name="FormCard" Grid.Row="1" Style="{StaticResource Card}" Padding="28" VerticalOptions="Start">
                <VerticalStackLayout Spacing="26">

                    <!-- Type -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Type" Style="{StaticResource Overline}" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding TypeOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterOption">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}">
                                                <TapGestureRecognizer.Command>
                                                    <Binding Path="SelectTypeCommand"
                                                             Source="{RelativeSource AncestorType={x:Type vm:AddEditTransactionViewModel}}"
                                                             x:DataType="vm:AddEditTransactionViewModel" />
                                                </TapGestureRecognizer.Command>
                                            </TapGestureRecognizer>
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Name}" FontFamily="InterMedium" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Amount -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Amount" Style="{StaticResource Overline}" />
                        <Border Style="{StaticResource InputShell}" Padding="16,4">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <controls:PickerField WidthRequest="90" VerticalOptions="Center">
                                    <Picker ItemsSource="{Binding SupportedCurrencies}"
                                            SelectedItem="{Binding CurrencyCode}"
                                            FontFamily="InterSemiBold"
                                            FontSize="17"
                                            TextColor="{StaticResource Muted}" />
                                </controls:PickerField>
                                <Entry Grid.Column="1"
                                       Text="{Binding AmountText}"
                                       Placeholder="0.00"
                                       Keyboard="Numeric"
                                       FontFamily="InterSemiBold"
                                       FontSize="30"
                                       MinimumHeightRequest="64"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Category -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Category" Style="{StaticResource Overline}" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding CategoryOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryOption">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,8" Padding="12,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}">
                                                <TapGestureRecognizer.Command>
                                                    <Binding Path="SelectCategoryCommand"
                                                             Source="{RelativeSource AncestorType={x:Type vm:AddEditTransactionViewModel}}"
                                                             x:DataType="vm:AddEditTransactionViewModel" />
                                                </TapGestureRecognizer.Command>
                                            </TapGestureRecognizer>
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Image Source="{Binding Category.IconFile}" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                                            <Label Text="{Binding Category.Name}" FontFamily="InterMedium" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Accounts, date, notes -->
                    <Grid x:Name="FieldsGrid"
                          ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="22">

                        <VerticalStackLayout x:Name="FromField" Spacing="10">
                            <Label Text="{Binding AccountLabel}" Style="{StaticResource Overline}" />
                            <Border Style="{StaticResource InputShell}">
                                <controls:PickerField>
                                    <Picker Title="{OnPlatform Default='Choose account', WinUI={x:Null}}"
                                            ItemsSource="{Binding Accounts}"
                                            SelectedItem="{Binding SelectedAccount}">
                                        <Picker.ItemDisplayBinding>
                                            <Binding Path="Name" x:DataType="models:Account" />
                                        </Picker.ItemDisplayBinding>
                                    </Picker>
                                </controls:PickerField>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="ToField" Grid.Column="1" Spacing="10" IsVisible="{Binding ShowToAccount}">
                            <Label Text="To account" Style="{StaticResource Overline}" />
                            <Border Style="{StaticResource InputShell}">
                                <controls:PickerField>
                                    <Picker Title="{OnPlatform Default='Choose account', WinUI={x:Null}}"
                                            ItemsSource="{Binding Accounts}"
                                            SelectedItem="{Binding SelectedToAccount}">
                                        <Picker.ItemDisplayBinding>
                                            <Binding Path="Name" x:DataType="models:Account" />
                                        </Picker.ItemDisplayBinding>
                                    </Picker>
                                </controls:PickerField>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="DateField" Grid.Row="1" Spacing="10">
                            <Label Text="Date" Style="{StaticResource Overline}" />
                            <Border Style="{StaticResource InputShell}">
                                <controls:PickerField Glyph="icon_calendar.png">
                                    <DatePicker Date="{Binding Date}" Format="d MMM yyyy" />
                                </controls:PickerField>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="NotesField" Grid.Row="1" Grid.Column="1" Spacing="10">
                            <Label Text="Notes" Style="{StaticResource Overline}" />
                            <Border Style="{StaticResource InputShell}">
                                <Entry Text="{Binding Notes}" Placeholder="Optional" MaxLength="500" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}" />

                    <!-- Actions -->
                    <Grid x:Name="ActionsGrid" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Button x:Name="DeleteButton"
                                Text="Delete"
                                Style="{StaticResource DangerButton}"
                                IsVisible="{Binding IsEditing}"
                                Command="{Binding DeleteCommand}" />
                        <Button x:Name="CancelButton"
                                Grid.Column="2"
                                Text="Cancel"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding CancelCommand}" />
                        <Button x:Name="SaveButton"
                                Grid.Column="3"
                                Text="{Binding SaveLabel}"
                                Command="{Binding SaveCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>

</views:AppPage>
