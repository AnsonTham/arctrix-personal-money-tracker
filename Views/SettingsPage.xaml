<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:views="clr-namespace:Arctrix.PersonalMoneyTracker.Views"
             xmlns:controls="clr-namespace:Arctrix.PersonalMoneyTracker.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Arctrix.PersonalMoneyTracker.ViewModels"
             x:Class="Arctrix.PersonalMoneyTracker.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout x:Name="LayoutRoot"
                             HorizontalOptions="Center"
                             Padding="{StaticResource PagePaddingDesktop}"
                             Spacing="24">

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutStates">
                    <VisualState x:Name="Wide" />
                    <VisualState x:Name="Narrow">
                        <VisualState.Setters>
                            <Setter Property="Padding" Value="{StaticResource PagePaddingPhone}" />
                            <Setter Property="Spacing" Value="16" />
                            <Setter TargetName="Header" Property="Margin" Value="4,16,4,0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="Header" ColumnDefinitions="Auto,*">
                <controls:BackButton />
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label Text="{Binding Title}" Style="{StaticResource H1}" />
                    <Label Text="Currency and app information" Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Base currency -->
            <Border Style="{StaticResource Card}" Padding="24">
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Base currency" Style="{StaticResource H2}" />
                        <Label Text="Balances and net worth are converted into this currency live. Past transactions keep the base currency they were recorded in and are labeled with it."
                               Style="{StaticResource Body}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource InputShell}" WidthRequest="200" HorizontalOptions="Start">
                        <controls:PickerField>
                            <Picker ItemsSource="{Binding SupportedCurrencies}" SelectedItem="{Binding BaseCurrency}" />
                        </controls:PickerField>
                    </Border>

                    <HorizontalStackLayout Spacing="14">
                        <Button Text="Save" Command="{Binding SaveCommand}" />
                        <Label Text="{Binding StatusMessage}"
                               Style="{StaticResource Body}"
                               IsVisible="{Binding HasStatus}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Exchange rates -->
            <Border Style="{StaticResource Card}" Padding="24">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Exchange rates" Style="{StaticResource H2}" />
                        <Label Text="Fixed rates, applied when you record a transaction in another currency."
                               Style="{StaticResource Body}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ExchangeRates}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExchangeRateRow">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,11">
                                        <Label Text="{Binding FromLabel}" Style="{StaticResource BodyStrong}" />
                                        <Label Grid.Column="1" Text="{Binding ToLabel}" Style="{StaticResource Amount}" FontFamily="InterRegular" />
                                    </Grid>
                                    <BoxView Style="{StaticResource Divider}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Image Source="arctrix_wallet_mark.png" WidthRequest="40" HeightRequest="40" VerticalOptions="Start" />
                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                        <Label Text="Arctrix Personal Money Tracker" Style="{StaticResource H3}" />
                        <Label Text="{Binding AppVersion}" Style="{StaticResource Caption}" />
                        <Label Text="All data is stored on this device." Style="{StaticResource Body}" Margin="0,8,0,0" />
                        <Label Text="{Binding DataFolder}" Style="{StaticResource Caption}" LineBreakMode="CharacterWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</views:AppPage>
