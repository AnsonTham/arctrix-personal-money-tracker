<?xml version="1.0" encoding="utf-8" ?>
<views:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:views="clr-namespace:Arctrix.PersonalMoneyTracker.Views"
             xmlns:controls="clr-namespace:Arctrix.PersonalMoneyTracker.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Arctrix.PersonalMoneyTracker.ViewModels"
             x:Class="Arctrix.PersonalMoneyTracker.Views.EditAccountPage"
             x:DataType="vm:EditAccountViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <Grid x:Name="LayoutRoot" HorizontalOptions="Center" Padding="32,28,32,40" RowDefinitions="Auto,Auto" RowSpacing="20">

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutStates">
                    <VisualState x:Name="Wide" />
                    <VisualState x:Name="Narrow">
                        <VisualState.Setters>
                            <Setter Property="Padding" Value="{StaticResource PagePaddingPhone}" />
                            <Setter Property="RowSpacing" Value="16" />
                            <Setter TargetName="Header" Property="Margin" Value="0,8,0,0" />
                            <Setter TargetName="FormCard" Property="Padding" Value="18" />
                            <Setter TargetName="ActionsGrid" Property="Grid.ColumnDefinitions" Value="*" />
                            <Setter TargetName="ActionsGrid" Property="Grid.RowDefinitions" Value="Auto,Auto" />
                            <Setter TargetName="SaveButton" Property="Grid.Column" Value="0" />
                            <Setter TargetName="CancelButton" Property="Grid.Column" Value="0" />
                            <Setter TargetName="CancelButton" Property="Grid.Row" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="Header" ColumnDefinitions="Auto,*">
                <controls:BackButton />
                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource H1}" VerticalOptions="Center" />
            </Grid>

            <Border x:Name="FormCard" Grid.Row="1" Style="{StaticResource Card}" Padding="28" VerticalOptions="Start">
                <VerticalStackLayout Spacing="24">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Name" Style="{StaticResource Overline}" />
                        <Border Style="{StaticResource InputShell}">
                            <Entry Text="{Binding Name}" Placeholder="e.g. Main Bank" MaxLength="80" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Type" Style="{StaticResource Overline}" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding TypeOptions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountTypeOption">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer CommandParameter="{Binding .}">
                                                <TapGestureRecognizer.Command>
                                                    <Binding Path="SelectTypeCommand"
                                                             Source="{RelativeSource AncestorType={x:Type vm:EditAccountViewModel}}"
                                                             x:DataType="vm:EditAccountViewModel" />
                                                </TapGestureRecognizer.Command>
                                            </TapGestureRecognizer>
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Label}" FontFamily="InterMedium" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Balance" Style="{StaticResource Overline}" />
                        <Border Style="{StaticResource InputShell}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="{Binding Currency}" FontFamily="InterSemiBold" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                                <Entry Grid.Column="1" Text="{Binding BalanceText}" Placeholder="0.00" Keyboard="Numeric" />
                            </Grid>
                        </Border>
                        <!-- Correcting the balance is recorded, not silently overwritten. -->
                        <Label Text="{Binding AdjustmentPreview}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>

                    <Label Text="The currency can't be changed: every transaction on this account stores the exchange rate it was recorded at."
                           Style="{StaticResource Caption}" />

                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}" />

                    <Grid x:Name="ActionsGrid" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Button x:Name="CancelButton" Grid.Column="1" Text="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" />
                        <Button x:Name="SaveButton" Grid.Column="2" Text="Save changes" Command="{Binding SaveCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>

</views:AppPage>
