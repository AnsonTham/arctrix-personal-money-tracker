<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Arctrix dark-graphite palette.
        8-digit hex values are #AARRGGBB (alpha first).
        Android status/nav colors live in Platforms/Android/Resources/values/colors.xml.
    -->

    <!-- Surfaces, darkest to lightest -->
    <Color x:Key="Bg">#080A0E</Color>
    <Color x:Key="Surface">#10141A</Color>
    <Color x:Key="Surface2">#171C23</Color>
    <Color x:Key="Surface3">#1E242D</Color>
    <Color x:Key="Line">#252C35</Color>
    <Color x:Key="LineStrong">#343C47</Color>

    <!-- Brand -->
    <Color x:Key="Accent">#E6B450</Color>
    <Color x:Key="AccentHover">#F0C46C</Color>
    <Color x:Key="AccentSoft">#24E6B450</Color>
    <Color x:Key="OnAccent">#17120A</Color>
    <Color x:Key="BrandCyan">#36C5E8</Color>

    <!-- Semantic -->
    <Color x:Key="Positive">#22D3A2</Color>
    <Color x:Key="PositiveSoft">#1F22D3A2</Color>
    <Color x:Key="Negative">#FF6B83</Color>
    <Color x:Key="NegativeSoft">#1FFF6B83</Color>

    <!-- Income vs spending chart series. Validated as an adjacent pair on Surface with the
         dataviz checks: deuteranopia dE 13.8, normal-vision dE 36.4, contrast 9.6:1 and 4.8:1.
         (Positive next to Negative collapses to dE 5.4 under deuteranopia, below the floor.) -->
    <Color x:Key="ChartIncome">#22D3A2</Color>
    <Color x:Key="ChartExpense">#E5475F</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#EEF1F5</Color>
    <Color x:Key="TextSecondary">#B4BCC8</Color>
    <Color x:Key="Muted">#8F98A7</Color>
    <Color x:Key="TextFaint">#7E8795</Color>

    <!-- Solid brushes -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrong}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}" />
    <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource Positive}" />
    <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource Negative}" />

    <!-- Restrained gradients -->
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1C222B" Offset="0" />
        <GradientStop Color="#13171D" Offset="0.55" />
        <GradientStop Color="#0E1116" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGlowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2EE6B450" Offset="0" />
        <GradientStop Color="#00E6B450" Offset="0.7" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D1015" Offset="0" />
        <GradientStop Color="#080A0E" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
