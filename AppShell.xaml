<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="Arctrix.PersonalMoneyTracker.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       Title="Arctrix"
       FlyoutWidth="{StaticResource SidebarWidth}"
       FlyoutBackground="{StaticResource SidebarBrush}">

    <!-- Navigation items are created in code-behind: sidebar on desktop/tablet, tab bar on phone. -->

    <Shell.FlyoutHeader>
        <Grid Padding="22,30,22,22" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Image Source="arctrix_mark.png"
                   WidthRequest="36"
                   HeightRequest="32"
                   VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                <Label Text="Arctrix" Style="{StaticResource H3}" FontSize="17" />
                <Label Text="Money Tracker" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Grid Padding="0,2" WidthRequest="216" HeightRequest="48" HorizontalOptions="Start">
                <Border x:Name="Pill"
                        Background="Transparent"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,0">
                    <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                        <Image x:Name="ItemIcon"
                               Source="{Binding FlyoutIcon}"
                               WidthRequest="20"
                               HeightRequest="20"
                               Opacity="0.55"
                               VerticalOptions="Center" />
                        <Label x:Name="ItemTitle"
                               Grid.Column="1"
                               Text="{Binding Title}"
                               FontFamily="InterMedium"
                               FontSize="14"
                               TextColor="{StaticResource Muted}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter TargetName="Pill" Property="Border.Background" Value="{StaticResource AccentSoftBrush}" />
                                    <Setter TargetName="ItemIcon" Property="Image.Opacity" Value="1" />
                                    <Setter TargetName="ItemTitle" Property="Label.TextColor" Value="{StaticResource Accent}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutFooter>
        <Label Text="Arctrix Solutions"
               Style="{StaticResource Caption}"
               TextColor="{StaticResource TextFaint}"
               Margin="24,16,24,24" />
    </Shell.FlyoutFooter>

</Shell>
