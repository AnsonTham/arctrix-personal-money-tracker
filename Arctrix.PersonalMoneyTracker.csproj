<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Arctrix.PersonalMoneyTracker</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Generate C# from XAML at compile time: faster startup, and XAML mistakes fail the build. -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Arctrix Personal Money Tracker</ApplicationTitle>
    <ApplicationId>com.arctrix.personal.moneytracker</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon (also the Windows exe/taskbar icon): dark tile with the wallet mark layered on top.
         Android launchers mask icons to a circle or squircle, so the mark is scaled down there to stay
         inside the adaptive-icon safe zone; unmasked icons (Windows taskbar) keep it large. -->
    <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'"
              Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\Images\arctrix_wallet_mark.png" ForegroundScale="0.5" Color="#080A0E" />
    <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'"
              Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\Images\arctrix_wallet_mark.png" ForegroundScale="0.8" Color="#080A0E" />

    <!-- Splash screen: the wallet mark on the app background. A separate copy, because a splash
         and an in-app image built from the same file would produce clashing Android resources. -->
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#080A0E" BaseSize="160,160" />

    <!-- In-app images. BaseSize is the 1x size; higher densities are generated from the source. -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\arctrix_wallet_mark.png" BaseSize="48,48" />

    <!-- Inter (SIL OFL, see ThirdPartyNotices) -->
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- QuestPDF only renders on desktop, so PDF reports are Windows-only for now. Other targets
       don't reference it or compile ReportService; they register UnsupportedReportService. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
    <!-- Telegram.Bot is used for one thing: sending the bot's replies. Incoming messages always come
         through the relay repository, never from getUpdates (see TelegramBotService). -->
    <PackageReference Include="Telegram.Bot" Version="22.10.3.1" />
  </ItemGroup>

  <!-- The Telegram bot is a Windows-app feature; phones aren't running the relay client. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <Compile Remove="Services\Telegram\**\*.cs" />
  </ItemGroup>

  <!-- The bot token and GitHub PAT live in a gitignored file next to the project; copy it beside the
       executable when it exists, so a build from source picks it up. It is never part of the repo. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' And Exists('$(MSBuildProjectDirectory)\telegram.local.json')">
    <None Include="telegram.local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <Compile Remove="Services\ReportService.cs" />
  </ItemGroup>

  <!-- Receipt scanning has no desktop UI: Windows builds leave out its pages and view models. The OCR
       contract itself is compiled there, because the Telegram bot reads receipts sent to it. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <Compile Remove="ViewModels\ScanReceiptViewModel.cs" />
    <Compile Remove="ViewModels\ReceiptPhotoViewModel.cs" />
    <Compile Remove="Views\ScanReceiptPage.xaml.cs" />
    <Compile Remove="Views\ReceiptPhotoPage.xaml.cs" />
    <MauiXaml Remove="Views\ScanReceiptPage.xaml" />
    <MauiXaml Remove="Views\ReceiptPhotoPage.xaml" />
  </ItemGroup>

  <!-- Receipt scanning is mobile-only. Android reads text with Google ML Kit's bundled Latin model
       (on-device, no key or network); iOS uses Apple's Vision framework, which needs no package. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.9" />
    <!-- ML Kit's dependencies pin older AndroidX Kotlin-extension packages than the AndroidX versions
         MAUI resolves; reference the matching releases so the graph is consistent (NU1608). -->
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
  </ItemGroup>

</Project>
